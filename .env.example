# Copy to .env for local Docker Compose. Never commit real secret values.
# In Hamravesh enter these in private environment variables.
PUBLIC_URL=https://YOUR-APP-DOMAIN
# Entire preserved SERVER_RUNTIME_SECRETS.json as a single JSON line:
SERVER_RUNTIME_SECRETS=
# Alternatively provide its three fields separately, preserving the same values:
# DATA_ENCRYPTION_KEY=
# SESSION_SIGNING_KEY=
# ADMIN_TOKEN_SHA256=
# SHA-256 of the random APP_RELEASE_UPLOAD_TOKEN stored in GitHub Actions secrets.
# Generate with: printf %s "$APP_RELEASE_UPLOAD_TOKEN" | sha256sum
APP_RELEASE_UPLOAD_TOKEN_SHA256=
