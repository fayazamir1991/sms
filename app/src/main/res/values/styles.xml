<resources>
 <style name="Theme.Delneveshte.Base" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:fontFamily">@font/vazirmatn_regular</item>
  <item name="android:colorAccent">@color/brand_red</item>
  <item name="android:colorControlActivated">@color/brand_red</item>
  <item name="android:colorControlNormal">@color/secondary_text</item>
  <item name="android:colorControlHighlight">#18C8324D</item>
  <item name="android:textColorPrimary">@color/main_text</item><item name="android:textColorSecondary">@color/secondary_text</item>
  <item name="android:windowBackground">@color/page_background</item>
  <item name="android:statusBarColor">@color/page_background</item><item name="android:navigationBarColor">@color/surface</item>
  <item name="android:windowLightStatusBar">true</item>
  <item name="android:alertDialogTheme">@style/Theme.Delneveshte.Dialog</item>
  <item name="android:datePickerDialogTheme">@style/Theme.Delneveshte.Dialog</item><item name="android:timePickerDialogTheme">@style/Theme.Delneveshte.Dialog</item>
  <item name="android:popupMenuStyle">@style/Widget.Delneveshte.PopupMenu</item>
 </style>
 <style name="Theme.Delneveshte" parent="Theme.Delneveshte.Base"/>
 <style name="Theme.Delneveshte.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
  <item name="android:fontFamily">@font/vazirmatn_regular</item><item name="android:colorAccent">@color/brand_red</item>
  <item name="android:textColorPrimary">@color/main_text</item><item name="android:textColorSecondary">@color/secondary_text</item>
  <item name="android:windowBackground">@drawable/bg_dialog</item>
  <item name="android:buttonBarPositiveButtonStyle">@style/Widget.Delneveshte.DialogButton</item><item name="android:buttonBarNegativeButtonStyle">@style/Widget.Delneveshte.DialogButton</item>
 </style>
 <style name="Widget.Delneveshte.DialogButton" parent="android:style/Widget.Material.Button.Borderless">
  <item name="android:textColor">@color/brand_red</item><item name="android:textAllCaps">false</item><item name="android:fontFamily">@font/vazirmatn_medium</item>
 </style>
 <style name="Widget.Delneveshte.PopupMenu" parent="android:style/Widget.Material.PopupMenu">
  <item name="android:popupBackground">@drawable/bg_dialog</item><item name="android:popupElevation">8dp</item>
 </style>
</resources>
