      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "affection",
        "longing"
      ]
    },
    {
      "text": "هرچه پیش تو کشم لعل لبت\nاز من بی سر و پا نپذیرد",
      "author": "عطار",
      "title": "غزل شمارهٔ ۲۲۰",
      "source_url": "https://ganjoor.net/attar/divana/ghazal-attar/sh220#bn7",
      "source": "ganjoor",
      "language": "fa",
