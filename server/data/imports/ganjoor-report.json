      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "فریاد که من از همه دیدار تو را\nمشتاق‌ترم وز همه محروم‌ترم",
      "author": "هاتف اصفهانی",
      "title": "رباعی شمارهٔ ۲۸",
      "source_url": "https://ganjoor.net/hatef/divan-hatef/robaee-hatef/sh28#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "longing",
        "together"
      ]
    },
    {
      "text": "راه وصل تو، راهِ پرآسیب\nدرد عشقِ تو، دردِ بی‌درمان",
      "author": "هاتف اصفهانی",
      "title": "ترجیع بند - که یکی هست و هیچ نیست جز او",
      "source_url": "https://ganjoor.net/hatef/divan-hatef/tarjeeband#bn4",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 3,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "together",
        "relationship"
      ]
    },
    {
      "text": "ز اول ره عشق تو مرا سهل نمود\nپنداشت رسد به منزل وصل تو زود",
      "author": "ابوسعید ابوالخیر",
      "title": "رباعی شمارهٔ ۲۷۰",
      "source_url": "https://ganjoor.net/abusaeed/robaee-aa/sh270#bn1",
