      "couplet_index": 190,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "longing",
        "together"
      ]
    },
    {
      "text": "از هرچه می‌رود، سخنِ دوست خوش‌تر است\nپیغام آشنا، نفَسِ روح‌پرور است",
      "author": "سعدی",
      "title": "غزل شمارهٔ  ۶۳",
      "source_url": "https://ganjoor.net/saadi/divan/ghazals/sh63#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
