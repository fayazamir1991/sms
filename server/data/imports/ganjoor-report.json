      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "relationship"
      ]
    },
    {
      "text": "در عشق تو حالتیش باشد که دمی\nهم با تو و هم بی تو قرارش نبود",
      "author": "ابوسعید ابوالخیر",
      "title": "رباعی شمارهٔ ۲۸۰",
      "source_url": "https://ganjoor.net/abusaeed/robaee-aa/sh280#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 9,
      "selection_signals": [
        "address",
        "longing",
        "together",
        "relationship"
      ]
    },
    {
      "text": "ز اشک محتشم افتاد شور اندر جهان بی تو\nتو خود هرگز نگفتی عاشق شوریدهٔ من کو",
      "author": "محتشم کاشانی",
      "title": "شمارهٔ ۵۳",
      "source_url": "https://ganjoor.net/mohtasham/divan-moh/ghazal-jalali/sh54#bn7",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 6,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "affection",
        "longing"
      ]
    },
    {
      "text": "غمزه زنان آمدی شاهسوار اجل\nتیغ به دست تو داد خود به کناری نشست",
      "author": "محتشم کاشانی",
      "title": "شمارهٔ  ۸۸",
      "source_url": "https://ganjoor.net/mohtasham/divan-moh/ghazal-moh/sh88#bn4",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 3,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "together",
        "relationship"
      ]
    },
    {
      "text": "چشم گریان مرا از گریه نتوان منع کرد\nتا به کام دل نبوسم لعل خندان تو را",
      "author": "فروغی بسطامی",
      "title": "غزل شمارهٔ ۱۱",
      "source_url": "https://ganjoor.net/forooghi/divan-forooghi/ghazalf/sh11#bn8",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 7,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "در وعده‌گاه وصل تو جانم به لب رسید\nامید مهر دادی و کشتی به کین مرا",
      "author": "فروغی بسطامی",
      "title": "غزل شمارهٔ ۲۱",
      "source_url": "https://ganjoor.net/forooghi/divan-forooghi/ghazalf/sh21#bn5",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 4,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "مرا ز وصل تو حاصل به جز تمنا نیست\nخیال زلف تو بستن خلاف سودا نیست",
      "author": "عبید زاکانی",
      "title": "غزل شمارهٔ ۲۰",
      "source_url": "https://ganjoor.net/obeyd/divan-obeyd/ghazal-obeyd/sh20#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "خرم آن کس که غم عشق تو در دل دارد\nوز همه ملک جهان مهر تو حاصل دارد",
      "author": "عبید زاکانی",
      "title": "غزل شمارهٔ ۵۷",
      "source_url": "https://ganjoor.net/obeyd/divan-obeyd/ghazal-obeyd/sh57#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "affection",
        "joy",
        "relationship"
      ]
    },
    {
      "text": "دلبرا، زوکی مجال حاسد غماز تو\nرنگ من با تو نبندد بیش ازین ملماز تو",
      "author": "رودکی",
      "title": "شمارهٔ ۱۳۰",
      "source_url": "https://ganjoor.net/roodaki/parakande/sh130#bn1",
