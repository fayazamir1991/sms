      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "سد لعب بلعجب شد و سد نقش بد نشست\nتا ریختیم با تو، بد افتاد نرد ما",
      "author": "وحشی بافقی",
