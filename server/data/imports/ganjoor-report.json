      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "ای که روی تو بهشت دل و جان است مرا\nای که وصل تو مراد دل و جان است مرا",
      "author": "سلمان ساوجی",
      "title": "غزل شمارهٔ ۱۰",
      "source_url": "https://ganjoor.net/salman/divanss/ghazalss/sh10#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "دل به‌دست تو وما ازتو، دگر مانع‌کیست\nخودنمایی نکند آینه آغاز چرا",
      "author": "بیدل دهلوی",
      "title": "غزل شمارهٔ ۶۷",
      "source_url": "https://ganjoor.net/bidel/ghazalbi/sh67#bn4",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
