      "couplet_index": 5,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "longing",
        "together"
      ]
    },
    {
      "text": "کاش رخ من بدی خاک کف پای تو\nبوسه مگر دادمی من کف پای ترا",
