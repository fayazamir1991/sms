      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "نه ماه فلک سیرم و نه مهر جهانتاب\nتا بوسهٔ من بر لب بام تو نویسند",
      "author": "صائب",
      "title": "تک‌بیت شمارهٔ ۷۷۹",
      "source_url": "https://ganjoor.net/saeb/divan-saeb/takbeit/sh779#bn1",
