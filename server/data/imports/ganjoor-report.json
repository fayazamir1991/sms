        "speaker",
        "together"
      ]
    },
    {
      "text": "به باغ وصل تو خاری رقیبِ صد ورد است\nبه یاد روی تو دردی طبیبِ صد درد است",
      "author": "خاقانی",
      "title": "غزل شمارهٔ ۵۱",
      "source_url": "https://ganjoor.net/khaghani/divankh/ghazalkh/sh51#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "together",
        "imagery"
      ]
    },
    {
      "text": "لبت چون چشمهٔ نوش است و ما اندر هوس مانده\nکه بر وصلِ لبت یک روز باشد دست‌رس ما را",
      "author": "انوری",
      "title": "غزل شمارهٔ ۱",
      "source_url": "https://ganjoor.net/anvari/divan-anvari/ghazala/sh1#bn4",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 3,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "رخت مه را رخ و فرزین نهادست\nلبت بیجاده را صد ضربه دادست",
      "author": "انوری",
      "title": "غزل شمارهٔ ۱۹",
      "source_url": "https://ganjoor.net/anvari/divan-anvari/ghazala/sh19#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "together",
        "imagery"
      ]
    },
    {
      "text": "مبارک روز بود امروز، یارا\nکه دیدار تو روزی گشت ما را",
      "author": "اوحدی مراغه‌ای",
      "title": "غزل شمارهٔ ۹",
      "source_url": "https://ganjoor.net/ouhadi/divano/ghazalo/sh9#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "شاد نابوده ز وصل تو من و نابوده\nتوجفا کرده و من داشته معذور ترا",
      "author": "اوحدی مراغه‌ای",
      "title": "غزل شمارهٔ ۱۲",
      "source_url": "https://ganjoor.net/ouhadi/divano/ghazalo/sh12#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "من از وصال تو دل برگرفته بودم، لیک\nزبان لطف توام باز در گمان انداخت",
      "author": "عراقی",
      "title": "غزل شمارهٔ ۱۰",
      "source_url": "https://ganjoor.net/eraghi/divane/ghazale/sh10#bn6",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 5,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "تو در کنار من آ، تا من از میان بروم\nکه هر کجا که برآید یقین گمان برخاست",
      "author": "عراقی",
      "title": "غزل شمارهٔ ۱۹",
      "source_url": "https://ganjoor.net/eraghi/divane/ghazale/sh19#bn7",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 6,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "هزاران شکوه بر لب بود یاران را ز خوی تو\nبه شکرخنده آمد چون لبت، زد مهر بر لب‌ها",
      "author": "هاتف اصفهانی",
      "title": "غزل شمارهٔ ۲",
      "source_url": "https://ganjoor.net/hatef/divan-hatef/ghazal-hatef/sh2#bn3",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 2,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "together",
        "imagery"
      ]
    },
    {
      "text": "بوسه‌ای چند ز لعل لب تو می‌طلبم\nبشنوم تا ز لب لعل تو دشنامی چند",
      "author": "هاتف اصفهانی",
      "title": "غزل شمارهٔ ۳۰",
      "source_url": "https://ganjoor.net/hatef/divan-hatef/ghazal-hatef/sh30#bn4",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 3,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "together",
        "imagery"
      ]
    },
    {
      "text": "چشم و دل من به یاد دندان و لبت\nاین در خوشاب ریزد آن لعل مذاب",
      "author": "رشحه",
      "title": "شمارهٔ  ۵ - رباعی",
      "source_url": "https://ganjoor.net/rashhe/sh5#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "چو من کی با تو باشد عشق اغیار\nنیاید کار عیسی از خری چند",
      "author": "رشحه",
      "title": "شمارهٔ  ۱۳ - از یک غزل",
      "source_url": "https://ganjoor.net/rashhe/sh13#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "با لطف و نوازش وصال تو مرا\nدردادن صد هزار جان ننگی نیست",
      "author": "ابوسعید ابوالخیر",
      "title": "رباعی شمارهٔ ۱۵۳",
      "source_url": "https://ganjoor.net/abusaeed/robaee-aa/sh153#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "گر بوسه دهد زلف تو را رنجه مشو\nدیوانه که زنجیر نخاید چه کند؟",
      "author": "ابوسعید ابوالخیر",
      "title": "رباعی شمارهٔ ۲۵۲",
      "source_url": "https://ganjoor.net/abusaeed/robaee-aa/sh252#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "together",
        "imagery"
      ]
    },
    {
      "text": "چه خوش بی وصلت آهنگ ملک بی\nمرا وصل تو آرام دلک بی",
      "author": "باباطاهر",
      "title": "دوبیتی شمارهٔ ۲۹۶",
      "source_url": "https://ganjoor.net/babataher/2beytiha/sh296#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "مرا زیاده ز حد کرده است با خود نیک\nرسیده کار به آن هم که با تو بد کندم",
      "author": "محتشم کاشانی",
      "title": "شمارهٔ ۳۶",
      "source_url": "https://ganjoor.net/mohtasham/divan-moh/ghazal-jalali/sh37#bn4",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 3,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "به بیماری کشید از حسرت کار دگر یاران\nولی آن کس که مرد از شوق دیدار تو من بودم",
      "author": "محتشم کاشانی",
      "title": "شمارهٔ ۳۷",
      "source_url": "https://ganjoor.net/mohtasham/divan-moh/ghazal-jalali/sh38#bn5",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 4,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "منصب دنیا نمی‌دانی که چیست؟\nمن بگویم با تو، یک ساعت بایست",
      "author": "شیخ بهایی",
      "title": "بخش ۱۹ - فی ذم المتمکنین فی المناصب الدنیویة للحظوظ الواهیة الدنیة",
      "source_url": "https://ganjoor.net/bahaee/nan-halva/sh19#bn3",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 2,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "من عدوم، چاره نبود کز منی\nکژ روم، با تو نمایم دشمنی",
      "author": "شیخ بهایی",
      "title": "بخش ۴ - قال المولوی المعنوی",
      "source_url": "https://ganjoor.net/bahaee/nan-paneer/sh4#bn5",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 4,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "دانی کدامین مست را بر لب توان زد بوسه‌ها\nمستی که بوسد دم به دم لبهای خندان تو را",
      "author": "فروغی بسطامی",
      "title": "غزل شمارهٔ ۱۰",
      "source_url": "https://ganjoor.net/forooghi/divan-forooghi/ghazalf/sh10#bn10",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 9,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "together",
        "joy",
        "imagery"
      ]
    },
    {
      "text": "چشم گریان مرا از گریه نتوان منع کرد\nتا به کام دل نبوسم لعل خندان تو را",
      "author": "فروغی بسطامی",
      "title": "غزل شمارهٔ ۱۱",
      "source_url": "https://ganjoor.net/forooghi/divan-forooghi/ghazalf/sh11#bn8",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 7,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "joy",
        "imagery"
      ]
    },
    {
      "text": "ای خط و خال خوشت مایهٔ سودای ما\nای نفسی وصل تو اصل تمنای ما",
      "author": "عبید زاکانی",
      "title": "غزل شمارهٔ ۵",
      "source_url": "https://ganjoor.net/obeyd/divan-obeyd/ghazal-obeyd/sh5#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "در ره کعبهٔ وصل تو ز پا ننشینیم\nگرچه در پا شکند خار مغیلان ما را",
      "author": "عبید زاکانی",
      "title": "غزل شمارهٔ ۸",
      "source_url": "https://ganjoor.net/obeyd/divan-obeyd/ghazal-obeyd/sh8#bn5",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 4,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "گشاده کن چنان چشم امیدم\nکه بخت آرد ز دیدارت نویدم",
      "author": "امیرخسرو دهلوی",
      "title": "شمارهٔ ۶۶ - نیازمندی در حضرت بی نیازی که دماغ مختل بندگان را از گلشن یحبهم و یحبونه بوی بخشیده",
      "source_url": "https://ganjoor.net/khosro/gozide/masnaviatkh/sh66#bn19",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 18,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "together",
        "imagery"
      ]
    },
    {
      "text": "مرا در ملک خود کاری درافتاد\nرسیدم با تو کاری دیگر افتاد",
      "author": "امیرخسرو دهلوی",
      "title": "بخش ۱۰ - آگاه کردن خسرو شیرین را از قصد سفر خود به سوی قیصر روم",
      "source_url": "https://ganjoor.net/khosro/gozide/khosro-shirin2/sh10#bn5",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 4,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "لبت سیب بهشت و من محتاج\nیافتن را همی نیابم ویل",
      "author": "رودکی",
      "title": "شمارهٔ ۹۲",
      "source_url": "https://ganjoor.net/roodaki/parakande/sh92#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "در سر مستی گر از زانوی من بالین کنی\nبوسه در لعل شراب آلود نگذارم ترا",
      "author": "صائب",
      "title": "تک‌بیت شمارهٔ ۴۶",
      "source_url": "https://ganjoor.net/saeb/divan-saeb/takbeit/sh46#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "نه ماه فلک سیرم و نه مهر جهانتاب\nتا بوسهٔ من بر لب بام تو نویسند",
      "author": "صائب",
      "title": "تک‌بیت شمارهٔ ۷۷۹",
      "source_url": "https://ganjoor.net/saeb/divan-saeb/takbeit/sh779#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "نخستین عهد ما را با تو آنست\nکزو ترسی که دادار جهانست",
      "author": "فخرالدین اسعد گرگانی",
      "title": "بخش ۵ - گفتار اندر گرفتن سلطان شهر اصفهان را",
      "source_url": "https://ganjoor.net/asad/veysoramin/sh5#bn33",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 32,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "مرا نوروز دیدار تو باشد\nهوای خوش ز گفتار تو باشد",
      "author": "فخرالدین اسعد گرگانی",
      "title": "بخش ۷ - برون آمدن سلطان از اصفهان و داستان گویندهء کتاب",
      "source_url": "https://ganjoor.net/asad/veysoramin/sh7#bn25",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 24,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "با تو باشم وسعت دل بگذرد از عرش هم\nبی تو باشم هر دو عالم یک قفس باشد مرا",
      "author": "فیض کاشانی",
      "title": "غزل شمارهٔ ۱۹",
      "source_url": "https://ganjoor.net/feyz/divanz/ghazalz/sh19#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "longing",
        "together"
      ]
    },
    {
      "text": "گر آرزوی دولت وصل تو نبودی\nخاطر به چه خوش داشتی از خویش دل ما؟",
      "author": "فیض کاشانی",
      "title": "غزل شمارهٔ ۳۶",
      "source_url": "https://ganjoor.net/feyz/divanz/ghazalz/sh36#bn6",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 5,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "از صحبت من با تو، برخاست بسی فتنه\nدیوانه چو بنشیند، با مست بود غوغا",
      "author": "سلمان ساوجی",
      "title": "غزل شمارهٔ ۲",
      "source_url": "https://ganjoor.net/salman/divanss/ghazalss/sh2#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "بی‌وصل تو دو کون، سرابی است پیش ما\nدر پیش ما چه آب بود خود سراب را؟",
      "author": "سلمان ساوجی",
      "title": "غزل شمارهٔ ۶",
      "source_url": "https://ganjoor.net/salman/divanss/ghazalss/sh6#bn8",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 7,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "گرد ما راکه نشسته‌ست به راه طلبت\nبه خرامی نتوان‌کرد سرافراز چرا",
      "author": "بیدل دهلوی",
      "title": "غزل شمارهٔ ۶۷",
      "source_url": "https://ganjoor.net/bidel/ghazalbi/sh67#bn3",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 2,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "من هلاک طرزاخلاقم چه‌خشم وکوعتاب\nبوی‌گل آیینه‌دار است از لبت دشنام را",
      "author": "بیدل دهلوی",
      "title": "غزل شمارهٔ ۱۱۰",
      "source_url": "https://ganjoor.net/bidel/ghazalbi/sh110#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "ما آب خضر بی تو حرام انگاریم\nیا زلف و رخ تو، صبح و شام انگاریم",
      "author": "رضی‌الدین آرتیمانی",
      "title": "رباعی شماره ۶۵",
      "source_url": "https://ganjoor.net/razi/robaeear/sh65#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "longing",
        "imagery"
      ]
    },
    {
      "text": "وصل تو کجا و همچو من هیچکسی\nروح القدسی نیاید از هر مگسی",
      "author": "رضی‌الدین آرتیمانی",
      "title": "رباعی شماره ۹۲",
      "source_url": "https://ganjoor.net/razi/robaeear/sh92#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "عصمت از لعل لبت گرد هوس می گردد\nفتنه مفروش که سیمرغ مگس می گردد",
      "author": "عرفی",
      "title": "غزل شمارهٔ ۱۸۴",
      "source_url": "https://ganjoor.net/orfi/ghazalor/sh184#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "together",
        "imagery"
      ]
    },
    {
      "text": "باش گر وصل تو از غیر که سنجیده دلم\nلذت وصل تو با چاشنی حسرت خویش",
      "author": "عرفی",
      "title": "غزل شمارهٔ ۳۹۲",
      "source_url": "https://ganjoor.net/orfi/ghazalor/sh392#bn4",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 3,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "دور از تو صبوری نتواند دل من\nوصل تو حیات خویش داند دل من",
      "author": "هلالی جغتایی",
      "title": "رباعی شمارهٔ ۲۹",
      "source_url": "https://ganjoor.net/helali/robaeeh/sh29#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "من و وصل تو خیالیست که صورت نپذیرد\nکه ترا پایه بلندست و مرا طالع پستست",
      "author": "قاآنی",
      "title": "غزل شمارهٔ ۱۰",
      "source_url": "https://ganjoor.net/ghaani/ghazalgh/sh10#bn4",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 3,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    }
  ],
