      "selection_score": 8,
      "selection_signals": [
        "address",
        "together",
        "relationship",
        "imagery"
      ]
    },
    {
      "text": "هست بی من بسی شکست تو را\nکه نگیرد کسی به دست تو را",
      "author": "هلالی جغتایی",
      "title": "بخش ۲۷ - مناظرهٔ تیر و کمان با یکدیگر",
      "source_url": "https://ganjoor.net/helali/shahodarvish/sh27#bn8",
      "source": "ganjoor",
      "language": "fa",
