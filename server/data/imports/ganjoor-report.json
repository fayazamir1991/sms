      "source_url": "https://ganjoor.net/ouhadi/divano/ghazalo/sh52#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "جز دیدن روی تو مرا رای دگر نیست\nجز وصل توام هیچ تمنای دگر نیست",
      "author": "عراقی",
      "title": "غزل شمارهٔ ۳۵",
      "source_url": "https://ganjoor.net/eraghi/divane/ghazale/sh35#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "کای دلارامی که جان ما تویی\nبی تو ما را یک نفس آرام نیست",
      "author": "عراقی",
      "title": "غزل شمارهٔ ۳۸",
      "source_url": "https://ganjoor.net/eraghi/divane/ghazale/sh38#bn8",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 7,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "affection",
        "longing"
      ]
    },
    {
      "text": "چشم و دل من به یاد دندان و لبت\nاین در خوشاب ریزد آن لعل مذاب",
      "author": "رشحه",
      "title": "شمارهٔ  ۵ - رباعی",
      "source_url": "https://ganjoor.net/rashhe/sh5#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "پی وصل تو ما را زور و زر نیست\nنگاه حسرتی داریم و آهی",
      "author": "رشحه",
      "title": "شمارهٔ  ۲۹ - نامشخص",
      "source_url": "https://ganjoor.net/rashhe/sh29#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "فریاد که من از همه دیدار تو را\nمشتاق‌ترم وز همه محروم‌ترم",
      "author": "هاتف اصفهانی",
      "title": "رباعی شمارهٔ ۲۸",
      "source_url": "https://ganjoor.net/hatef/divan-hatef/robaee-hatef/sh28#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "longing",
        "together"
      ]
    },
    {
      "text": "ز اول ره عشق تو مرا سهل نمود\nپنداشت رسد به منزل وصل تو زود",
      "author": "ابوسعید ابوالخیر",
      "title": "رباعی شمارهٔ ۲۷۰",
      "source_url": "https://ganjoor.net/abusaeed/robaee-aa/sh270#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "affection",
        "together"
      ]
    },
    {
      "text": "هرگز دلم از یاد تو غافل نشود\nگر جان بشود مهر تو از دل نشود",
      "author": "ابوسعید ابوالخیر",
      "title": "رباعی شمارهٔ ۲۹۸",
      "source_url": "https://ganjoor.net/abusaeed/robaee-aa/sh298#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 9,
      "selection_signals": [
        "address",
        "speaker",
        "affection",
        "longing",
        "relationship"
      ]
    },
    {
      "text": "ز اشک محتشم افتاد شور اندر جهان بی تو\nتو خود هرگز نگفتی عاشق شوریدهٔ من کو",
      "author": "محتشم کاشانی",
      "title": "شمارهٔ ۵۳",
      "source_url": "https://ganjoor.net/mohtasham/divan-moh/ghazal-jalali/sh54#bn7",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 6,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "affection",
        "longing"
      ]
    },
    {
      "text": "بهشت وصل توام کشت ز اختلاط رقیبان\nمن و فراق تو کان دوزخ این عذاب ندارد",
      "author": "محتشم کاشانی",
      "title": "شمارهٔ  ۱۷۱",
      "source_url": "https://ganjoor.net/mohtasham/divan-moh/ghazal-moh/sh171#bn10",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 9,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "longing",
        "together"
      ]
    },
    {
      "text": "چشم گریان مرا از گریه نتوان منع کرد\nتا به کام دل نبوسم لعل خندان تو را",
      "author": "فروغی بسطامی",
      "title": "غزل شمارهٔ ۱۱",
      "source_url": "https://ganjoor.net/forooghi/divan-forooghi/ghazalf/sh11#bn8",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 7,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "در وعده‌گاه وصل تو جانم به لب رسید\nامید مهر دادی و کشتی به کین مرا",
      "author": "فروغی بسطامی",
      "title": "غزل شمارهٔ ۲۱",
      "source_url": "https://ganjoor.net/forooghi/divan-forooghi/ghazalf/sh21#bn5",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 4,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "مرا ز وصل تو حاصل به جز تمنا نیست\nخیال زلف تو بستن خلاف سودا نیست",
      "author": "عبید زاکانی",
      "title": "غزل شمارهٔ ۲۰",
      "source_url": "https://ganjoor.net/obeyd/divan-obeyd/ghazal-obeyd/sh20#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "خرم آن کس که غم عشق تو در دل دارد\nوز همه ملک جهان مهر تو حاصل دارد",
      "author": "عبید زاکانی",
      "title": "غزل شمارهٔ ۵۷",
      "source_url": "https://ganjoor.net/obeyd/divan-obeyd/ghazal-obeyd/sh57#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "affection",
        "joy",
        "relationship"
      ]
    },
    {
      "text": "دلبرا، زوکی مجال حاسد غماز تو\nرنگ من با تو نبندد بیش ازین ملماز تو",
      "author": "رودکی",
      "title": "شمارهٔ ۱۳۰",
      "source_url": "https://ganjoor.net/roodaki/parakande/sh130#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "affection",
        "together"
      ]
    },
    {
      "text": "در سر مستی گر از زانوی من بالین کنی\nبوسه در لعل شراب آلود نگذارم ترا",
      "author": "صائب",
      "title": "تک‌بیت شمارهٔ ۴۶",
      "source_url": "https://ganjoor.net/saeb/divan-saeb/takbeit/sh46#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "نه ماه فلک سیرم و نه مهر جهانتاب\nتا بوسهٔ من بر لب بام تو نویسند",
      "author": "صائب",
      "title": "تک‌بیت شمارهٔ ۷۷۹",
      "source_url": "https://ganjoor.net/saeb/divan-saeb/takbeit/sh779#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "بدان تا مهر تو بخشد به رامین\nپس او خسرو بود ما را تو شیرین",
      "author": "فخرالدین اسعد گرگانی",
      "title": "بخش ۲۷ - اندر باز آمدن دایه به نزدیک رامین به باغ",
      "source_url": "https://ganjoor.net/asad/veysoramin/sh27#bn230",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 229,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "affection",
        "joy",
        "relationship"
      ]
    },
    {
      "text": "توی چشم مرا خورشید روشن\nمرا دیدار تو باید نه داشن",
      "author": "فخرالدین اسعد گرگانی",
      "title": "بخش ۲۸ - دیدن ویس  رامین را و عاشق شدن بر او",
      "source_url": "https://ganjoor.net/asad/veysoramin/sh28#bn68",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 67,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "با تو باشم وسعت دل بگذرد از عرش هم\nبی تو باشم هر دو عالم یک قفس باشد مرا",
      "author": "فیض کاشانی",
      "title": "غزل شمارهٔ ۱۹",
      "source_url": "https://ganjoor.net/feyz/divanz/ghazalz/sh19#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "longing",
        "together"
      ]
    },
    {
      "text": "با تو حلال و بی تو حرامست عیشها\nیا رب حلال ساز بلطفت حرام ما",
      "author": "فیض کاشانی",
      "title": "غزل شمارهٔ ۳۹",
      "source_url": "https://ganjoor.net/feyz/divanz/ghazalz/sh39#bn4",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 3,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "longing",
        "together"
      ]
    },
    {
      "text": "گر منم دور ز روی تو، دل من با توست\nنیستی هیچ، ز حال دلم آگاه چرا؟",
      "author": "سلمان ساوجی",
      "title": "غزل شمارهٔ ۷",
      "source_url": "https://ganjoor.net/salman/divanss/ghazalss/sh7#bn3",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 2,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "ای که روی تو بهشت دل و جان است مرا\nای که وصل تو مراد دل و جان است مرا",
      "author": "سلمان ساوجی",
      "title": "غزل شمارهٔ ۱۰",
      "source_url": "https://ganjoor.net/salman/divanss/ghazalss/sh10#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "نفس از تو صبح‌خرمن نگه از تو گل‌به‌دامن\nتویی آنکه در بر من تهی از من است جایت",
      "author": "بیدل دهلوی",
      "title": "غزل شمارهٔ ۸۷۸",
      "source_url": "https://ganjoor.net/bidel/ghazalbi/sh878#bn8",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 7,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "joy"
      ]
    },
    {
      "text": "مرا به فکر لبت‌ کرد غنچهٔ گرداب\nنفس نفس به لب بحر بوسه دادن موج",
      "author": "بیدل دهلوی",
      "title": "غزل شمارهٔ ۸۹۰",
      "source_url": "https://ganjoor.net/bidel/ghazalbi/sh890#bn8",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 7,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "به مستی ار ز لبت بوسه‌ای طلب کردم\nلب پیاله در این جرم عذرخواه من است",
      "author": "قاآنی",
      "title": "غزل شمارهٔ ۱۳",
      "source_url": "https://ganjoor.net/ghaani/ghazalgh/sh13#bn6",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 5,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "اگر از خوردن می لعل لبت رنگینست\nبی‌سبب چیست که می تلخ و لبت شیرینست",
      "author": "قاآنی",
      "title": "غزل شمارهٔ ۱۴",
      "source_url": "https://ganjoor.net/ghaani/ghazalgh/sh14#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "together",
        "joy",
        "imagery"
      ]
    },
    {
      "text": "گر زانکه نزد بر لب من بوسه دل آرام\nبر لعل لب ما تو بببین کاین چه نشان است",
      "author": "شاه نعمت‌الله ولی",
      "title": "غزل شمارهٔ ۴۵۸",
      "source_url": "https://ganjoor.net/shahnematollah/ghazalshv/sh458#bn3",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 2,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "حالم ز عاشقان پرس تا با تو باز گویند\nاز عاقلان چه پرسی عاقل مرا چه داند",
      "author": "شاه نعمت‌الله ولی",
      "title": "غزل شمارهٔ ۵۹۲",
      "source_url": "https://ganjoor.net/shahnematollah/ghazalshv/sh592#bn3",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 2,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "affection",
        "together"
      ]
    },
    {
      "text": "در باغ دلم که روضه نعتش گوید\nآب طلبت روی چمن می شوید",
      "author": "عرفی",
      "title": "رباعی شمارهٔ ۸۴",
      "source_url": "https://ganjoor.net/orfi/robaeeor/sh84#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "در دهر مرا جز تو دل‌افروز مباد\nبر لعل لبت زمانه فیروز مباد",
      "author": "مهستی گنجوی",
      "title": "رباعی شمارۀ ۴۴",
      "source_url": "https://ganjoor.net/mahsati/robmah/sh44#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "چون زلف دراز تو شبی می‌باید\nتا با تو بگویم که فراق تو چه کرد",
      "author": "مهستی گنجوی",
      "title": "رباعی شمارۀ ۵۶",
      "source_url": "https://ganjoor.net/mahsati/robmah/sh56#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "longing",
        "together",
        "imagery"
      ]
    },
    {
      "text": "نازنینا، زین هوس مردم که خلق\nبا تو روزی در سخن بیند مرا",
      "author": "امیرخسرو دهلوی",
      "title": "شمارهٔ ۲۹",
      "source_url": "https://ganjoor.net/khosro/gozide/ghazalamkh/sh29#bn6",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 5,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "joy"
      ]
    },
    {
      "text": "باغم عشق تو می سازیم ما\nبا تو پنهان عشق می بازیم ما",
      "author": "امیرخسرو دهلوی",
      "title": "شمارهٔ ۳۱",
      "source_url": "https://ganjoor.net/khosro/gozide/ghazalamkh/sh31#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "affection",
        "together"
      ]
    },
    {
      "text": "مرا ز لعل تو یک بوسه آرزو کردن\nسزد که عرصه فراخ است مر تمنا را",
      "author": "سیف فرغانی",
      "title": "شمارهٔ ۴",
      "source_url": "https://ganjoor.net/seyf/divan-seyf/ghazalsk/sh4#bn8",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 7,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "روز وصل تو که احیای من کشته کند؟\nای تو جان داده به لب مردهٔ بویحیی را",
      "author": "سیف فرغانی",
      "title": "شمارهٔ ۸",
      "source_url": "https://ganjoor.net/seyf/divan-seyf/ghazalsk/sh8#bn14",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 13,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "در تن خزد ز بویه وصل تو مور مور\nدر من جهد ز انده هجر تو مار مار",
      "author": "مسعود سعد سلمان",
      "title": "شمارهٔ ۶",
      "source_url": "https://ganjoor.net/masood/divan-masood/ghazalmk/sh6#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "longing",
        "together"
      ]
    },
    {
      "text": "تا دو لبت از دور برانده ست مرا\nجز روی تو آرزو نمانده ست مرا",
      "author": "مسعود سعد سلمان",
      "title": "شمارهٔ ۱",
      "source_url": "https://ganjoor.net/masood/divan-masood/robaeemss/sh1#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "ما را به غیرِ یادِ تو، اندر ضَمیر نیست\nدِل را دِگَر ز صحبتِ جانان، گُزیر نیست",
      "author": "ابن حسام خوسفی",
      "title": "غزل شمارهٔ ۳۱",
      "source_url": "https://ganjoor.net/ebnehesam/ghazalebn/sh31#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "affection",
        "longing"
      ]
    },
    {
      "text": "بی تو حرامست تماشای باغ\nبا تو مرا از همه عالم فراغ",
      "author": "ابن حسام خوسفی",
      "title": "غزل شمارهٔ ۱۱۱",
      "source_url": "https://ganjoor.net/ebnehesam/ghazalebn/sh111#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "longing",
        "together"
      ]
    }
  ],
