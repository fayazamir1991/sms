      ]
    },
    {
      "text": "اگر از خوردن می لعل لبت رنگینست\nبی‌سبب چیست که می تلخ و لبت شیرینست",
      "author": "قاآنی",
      "title": "غزل شمارهٔ ۱۴",
      "source_url": "https://ganjoor.net/ghaani/ghazalgh/sh14#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "together",
        "joy",
        "imagery"
      ]
    },
    {
      "text": "در حرم ما در آ محرم مستانه شو\nمیکدهٔ عاشقان با تو بگویم کجاست",
      "author": "شاه نعمت‌الله ولی",
      "title": "غزل شمارهٔ ۱۹۴",
      "source_url": "https://ganjoor.net/shahnematollah/ghazalshv/sh194#bn3",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 2,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "affection",
        "together"
      ]
    },
    {
      "text": "گر زانکه نزد بر لب من بوسه دل آرام\nبر لعل لب ما تو بببین کاین چه نشان است",
      "author": "شاه نعمت‌الله ولی",
      "title": "غزل شمارهٔ ۴۵۸",
      "source_url": "https://ganjoor.net/shahnematollah/ghazalshv/sh458#bn3",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 2,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "در باغ دلم که روضه نعتش گوید\nآب طلبت روی چمن می شوید",
      "author": "عرفی",
      "title": "رباعی شمارهٔ ۸۴",
      "source_url": "https://ganjoor.net/orfi/robaeeor/sh84#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "گر این کار گردد به دست تو راست\nدر ایران جهان پهلوانی تراست",
      "author": "اسدی توسی",
      "title": "بخش ۱۹ - هنرها   نمودن   گرشاسب   پیش   ضحاک",
      "source_url": "https://ganjoor.net/asadi/garshaspname/sh19#bn26",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 25,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "together",
        "relationship"
      ]
    },
    {
      "text": "بهو شاد شد گفت اگر ز آنکه بخت\nبرآرد به دست تو این کار سخت",
      "author": "اسدی توسی",
      "title": "بخش ۳۵ - قصه زنگی با پهلوان گرشاسب",
      "source_url": "https://ganjoor.net/asadi/garshaspname/sh35#bn12",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 11,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "together",
        "relationship"
      ]
    },
    {
      "text": "در دهر مرا جز تو دل‌افروز مباد\nبر لعل لبت زمانه فیروز مباد",
      "author": "مهستی گنجوی",
      "title": "رباعی شمارۀ ۴۴",
      "source_url": "https://ganjoor.net/mahsati/robmah/sh44#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "چون زلف دراز تو شبی می‌باید\nتا با تو بگویم که فراق تو چه کرد",
      "author": "مهستی گنجوی",
      "title": "رباعی شمارۀ ۵۶",
      "source_url": "https://ganjoor.net/mahsati/robmah/sh56#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "longing",
        "together",
        "imagery"
      ]
    },
    {
      "text": "نازنینا، زین هوس مردم که خلق\nبا تو روزی در سخن بیند مرا",
      "author": "امیرخسرو دهلوی",
      "title": "شمارهٔ ۲۹",
      "source_url": "https://ganjoor.net/khosro/gozide/ghazalamkh/sh29#bn6",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 5,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "joy"
      ]
    },
    {
      "text": "باغم عشق تو می سازیم ما\nبا تو پنهان عشق می بازیم ما",
      "author": "امیرخسرو دهلوی",
      "title": "شمارهٔ ۳۱",
      "source_url": "https://ganjoor.net/khosro/gozide/ghazalamkh/sh31#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "relationship"
      ]
    },
    {
      "text": "مرا ز لعل تو یک بوسه آرزو کردن\nسزد که عرصه فراخ است مر تمنا را",
      "author": "سیف فرغانی",
      "title": "شمارهٔ ۴",
      "source_url": "https://ganjoor.net/seyf/divan-seyf/ghazalsk/sh4#bn8",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 7,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    }
