  "review_samples": [
    {
      "text": "که خرم کنم دل به دیدار تو\nکنون چون پسندم من آزار تو",
      "author": "فردوسی",
      "title": "بخش ۱۲ - دیدار رستم و اسفندیار بر لب هیرمند، آفرین دوسویه، دعوت به خان و سرباز زدن از بند",
      "source_url": "https://ganjoor.net/ferdousi/shahname/esfandyar/sh12#bn47",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 46,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "joy"
      ]
    },
    {
      "text": "چون چشمِ تو دل می‌برد از گوشه نشینان\nهمراهِ تو بودن گُنَه از جانب ما نیست",
      "author": "حافظ",
      "title": "غزل شمارهٔ ۶۹",
      "source_url": "https://ganjoor.net/hafez/ghazal/sh69#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "بداد لعلِ لبت بوسه‌ای به صد زاری\nگرفت کام دلم زو به صد هزار اِلحاح",
      "author": "حافظ",
      "title": "غزل شمارهٔ ۹۸",
      "source_url": "https://ganjoor.net/hafez/ghazal/sh98#bn6",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 5,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "به جان پاک تو ای معدن سخا و وفا\nکه صبر نیست مرا بی‌تو ای عزیز بیا",
      "author": "مولانا",
      "title": "غزل شمارهٔ ۲۲۷",
      "source_url": "https://ganjoor.net/moulavi/shams/ghazalsh/sh227#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "affection",
        "longing"
      ]
    },
    {
      "text": "روی کسی سرخ نشد بی‌مدد لعل لبت\nبی تو اگر سرخ بود از اثر غازه شود",
      "author": "مولانا",
      "title": "غزل شمارهٔ ۵۴۶",
      "source_url": "https://ganjoor.net/moulavi/shams/ghazalsh/sh546#bn5",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 4,
      "selection_policy": "balanced-v3",
      "selection_score": 8,
      "selection_signals": [
        "address",
        "longing",
        "together",
        "imagery"
      ]
    },
    {
      "text": "ندارم زَهرهٔ بوس لبانت\nچه بوسم؟ آستین یا آستانت‌؟",
      "author": "نظامی",
      "title": "بخش ۴۱ - مراد طلبیدن خسرو از شیرین و مانع شدن او",
      "source_url": "https://ganjoor.net/nezami/5ganj/khosro-shirin/sh41#bn78",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 77,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "مرا چون بَد نباشد حال بی تو؟\nکه بودم با تو پار امسال بی تو",
      "author": "نظامی",
      "title": "بخش ۵۲ - فرستادن خسرو شاپور را به طلب شیرین",
      "source_url": "https://ganjoor.net/nezami/5ganj/khosro-shirin/sh52#bn191",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
