      ]
    },
    {
      "text": "جز دیدن روی تو مرا رای دگر نیست\nجز وصل توام هیچ تمنای دگر نیست",
      "author": "عراقی",
      "title": "غزل شمارهٔ ۳۵",
      "source_url": "https://ganjoor.net/eraghi/divane/ghazale/sh35#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "کای دلارامی که جان ما تویی\nبی تو ما را یک نفس آرام نیست",
      "author": "عراقی",
      "title": "غزل شمارهٔ ۳۸",
      "source_url": "https://ganjoor.net/eraghi/divane/ghazale/sh38#bn8",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 7,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "affection",
        "longing"
      ]
    },
    {
      "text": "چشم و دل من به یاد دندان و لبت\nاین در خوشاب ریزد آن لعل مذاب",
      "author": "رشحه",
      "title": "شمارهٔ  ۵ - رباعی",
      "source_url": "https://ganjoor.net/rashhe/sh5#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "پی وصل تو ما را زور و زر نیست\nنگاه حسرتی داریم و آهی",
      "author": "رشحه",
      "title": "شمارهٔ  ۲۹ - نامشخص",
      "source_url": "https://ganjoor.net/rashhe/sh29#bn1",
      "source": "ganjoor",
