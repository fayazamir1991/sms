      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "کلید گنجها پیش تو آرم\nکم و بیشم به دست تو سپارم",
      "author": "فخرالدین اسعد گرگانی",
      "title": "بخش ۱۷ - آمدن شاه موبد به گوراب به جهت ویس",
      "source_url": "https://ganjoor.net/asad/veysoramin/sh17#bn27",
