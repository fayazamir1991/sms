      "selection_score": 7,
      "selection_signals": [
        "address",
        "together",
        "relationship"
      ]
    },
    {
      "text": "و گر گیتی به رویم سختی آرد\nمرا روزی به دست تو سپارد",
      "author": "فخرالدین اسعد گرگانی",
      "title": "بخش ۱۸ - جواب دادن ویس رسول شاه موبد را",
