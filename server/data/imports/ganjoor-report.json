      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "together",
        "relationship"
      ]
    },
    {
      "text": "نفس از تو صبح‌خرمن نگه از تو گل‌به‌دامن\nتویی آنکه در بر من تهی از من است جایت",
      "author": "بیدل دهلوی",
      "title": "غزل شمارهٔ ۸۷۸",
      "source_url": "https://ganjoor.net/bidel/ghazalbi/sh878#bn8",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 7,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "joy"
      ]
    },
    {
      "text": "هیچ رنجی به دست تو مرساد!\nچشم‌زخمی به شست تو مرساد!",
      "author": "هلالی جغتایی",
      "title": "بخش ۲۶ - در تعریف کمان شاه گوید",
      "source_url": "https://ganjoor.net/helali/shahodarvish/sh26#bn24",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 23,
