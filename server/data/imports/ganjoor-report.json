  "review_samples": [
    {
      "text": "که خرم کنم دل به دیدار تو\nکنون چون پسندم من آزار تو",
      "author": "فردوسی",
      "title": "بخش ۱۲ - دیدار رستم و اسفندیار بر لب هیرمند، آفرین دوسویه، دعوت به خان و سرباز زدن از بند",
      "source_url": "https://ganjoor.net/ferdousi/shahname/esfandyar/sh12#bn47",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 46,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "joy"
      ]
    },
    {
      "text": "به گلنار ماند همی چهر تو\nبه شادی بخندد دل از مهر تو",
      "author": "فردوسی",
      "title": "بخش ۱۲ - شکار بهرام گور، پریدن طغری و خواستگاری سه دختر برزین",
      "source_url": "https://ganjoor.net/ferdousi/shahname/bahgoor/sh12#bn80",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 79,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "affection",
        "joy",
        "relationship"
      ]
    },
    {
      "text": "چون چشمِ تو دل می‌برد از گوشه نشینان\nهمراهِ تو بودن گُنَه از جانب ما نیست",
      "author": "حافظ",
      "title": "غزل شمارهٔ ۶۹",
      "source_url": "https://ganjoor.net/hafez/ghazal/sh69#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "بداد لعلِ لبت بوسه‌ای به صد زاری\nگرفت کام دلم زو به صد هزار اِلحاح",
      "author": "حافظ",
      "title": "غزل شمارهٔ ۹۸",
      "source_url": "https://ganjoor.net/hafez/ghazal/sh98#bn6",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 5,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "به جان پاک تو ای معدن سخا و وفا\nکه صبر نیست مرا بی‌تو ای عزیز بیا",
      "author": "مولانا",
      "title": "غزل شمارهٔ ۲۲۷",
