      "couplet_index": 78,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "هر که دمی با تو بود یا قدمی رفت\nاز تو نباشد به هیچ روی شکیبا",
      "author": "سعدی",
      "title": "غزل شمارهٔ  ۳",
      "source_url": "https://ganjoor.net/saadi/divan/ghazals/sh3#bn3",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 2,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "together",
        "imagery"
      ]
    },
    {
      "text": "شربتی تلختر از زهر فراقت باید\nتا کند لذت وصل تو فراموش مرا",
      "author": "سعدی",
      "title": "غزل شمارهٔ  ۱۶",
      "source_url": "https://ganjoor.net/saadi/divan/ghazals/sh16#bn3",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 2,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "گر امید وصل تو در پی نباشد رهبرم\nتا ابد ره درکشد وادی هجران مرا",
      "author": "عطار",
      "title": "غزل شمارهٔ ۳",
      "source_url": "https://ganjoor.net/attar/divana/ghazal-attar/sh3#bn5",
      "source": "ganjoor",
