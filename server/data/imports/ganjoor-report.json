  "review_samples": [
    {
      "text": "هم دانهٔ امید به خرمن ماند\nهم باغ و سرای بی تو و من ماند",
      "author": "خیام",
      "title": "رباعی شمارهٔ ۹۴",
      "source_url": "https://ganjoor.net/khayyam/robaee/sh94#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "longing",
        "joy"
      ]
    },
    {
      "text": "که با تو چه گفت آن که خندان شدی\nگشاده لب و سیم دندان شدی",
      "author": "فردوسی",
      "title": "بخش ۷ - رفتن پنج ندیمهٔ رودابه به باغ سام و وصف کردن زیبایی رودابه سام را",
      "source_url": "https://ganjoor.net/ferdousi/shahname/manoochehr/sh7#bn39",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 38,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "together",
        "joy",
        "imagery"
      ]
    },
    {
      "text": "به دیدار تو داده‌ایمش نوید\nز ما بازگشتست دل پر امید",
      "author": "فردوسی",
      "title": "بخش ۸ - بازگشت ندیمه‌ها و شرح ماجرا برای رودابه",
      "source_url": "https://ganjoor.net/ferdousi/shahname/manoochehr/sh8#bn22",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 21,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "عزم دیدار تو دارد جانِ بر لب آمده\nباز گردد یا برآید؟ چیست فرمان شما؟",
      "author": "حافظ",
      "title": "غزل شمارهٔ ۱۲",
      "source_url": "https://ganjoor.net/hafez/ghazal/sh12#bn2",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 1,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "together",
        "imagery"
      ]
    },
    {
      "text": "هر سرِ مویِ مرا با تو هزاران کار است\nما کجاییم و مَلامت‌گرِ بی‌کار کجاست؟",
      "author": "حافظ",
      "title": "غزل شمارهٔ ۱۹",
      "source_url": "https://ganjoor.net/hafez/ghazal/sh19#bn5",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 4,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "together"
      ]
    },
    {
      "text": "مقبل‌ترین و نیک پی در برج زهره کیست؟ نی\nزیرا نهد لب بر لبت تا از تو آموزد نوا",
      "author": "مولانا",
      "title": "غزل شمارهٔ ۷",
      "source_url": "https://ganjoor.net/moulavi/shams/ghazalsh/sh7#bn17",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 16,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "together",
        "imagery"
      ]
    },
    {
      "text": "ای نوبهار عاشقان داری خبر از یار ما\nای از تو آبستن چمن ، وِی از تو خندان باغ‌ها",
      "author": "مولانا",
      "title": "غزل شمارهٔ ۱۲",
      "source_url": "https://ganjoor.net/moulavi/shams/ghazalsh/sh12#bn1",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 0,
      "selection_policy": "balanced-v3",
      "selection_score": 6,
      "selection_signals": [
        "address",
        "speaker",
        "affection",
        "joy"
      ]
    },
    {
      "text": "ندارم زَهرهٔ بوس لبانت\nچه بوسم؟ آستین یا آستانت‌؟",
      "author": "نظامی",
      "title": "بخش ۴۱ - مراد طلبیدن خسرو از شیرین و مانع شدن او",
      "source_url": "https://ganjoor.net/nezami/5ganj/khosro-shirin/sh41#bn78",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
      "source_revision": "34f4ab3e463903f9399d7ca208b9333911389f94",
      "couplet_index": 77,
      "selection_policy": "balanced-v3",
      "selection_score": 7,
      "selection_signals": [
        "address",
        "speaker",
        "together",
        "imagery"
      ]
    },
    {
      "text": "نگویم بوسه را میری به من دِه\nلبت را چاشنی‌گیری به من دِه",
      "author": "نظامی",
      "title": "بخش ۴۱ - مراد طلبیدن خسرو از شیرین و مانع شدن او",
      "source_url": "https://ganjoor.net/nezami/5ganj/khosro-shirin/sh41#bn79",
      "source": "ganjoor",
      "language": "fa",
      "rights": "classical-public-domain; reviewed named classical author",
